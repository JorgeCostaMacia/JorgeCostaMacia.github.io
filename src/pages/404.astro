---
import SiteFooter from '../components/SiteFooter.astro';
import { person } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title={`Page not found · ${person.name}`} description="This page does not exist." noindex>
  <main id="main" class="wrap">
    <h1>Page not found</h1>
    <p>
      This page does not exist. <a href="/">Go to the home page</a>.
    </p>
  </main>
  <SiteFooter />
</Base>

<style>
  main {
    padding-top: 72px;
  }
</style>
