---
import type { Project } from '../data/site';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul>
  {projects.map((p) => (
    <li>
      <ProjectCard project={p} />
    </li>
  ))}
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  li {
    display: flex;
  }
</style>
