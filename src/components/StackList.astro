---
interface Props {
  items: [string, string][];
}

const { items } = Astro.props;
---

<dl>
  {items.map(([area, what]) => (
    <div>
      <dt>{area}</dt>
      <dd>{what}</dd>
    </div>
  ))}
</dl>

<style>
  dl {
    margin: 0;
    display: grid;
    gap: 2px;
  }

  div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
